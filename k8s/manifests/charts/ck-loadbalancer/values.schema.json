{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "type": "object",
  "properties": {
    "l2": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interfaces": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ipPool": {
      "type": "object",
      "properties": {
        "cidrs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cidr": {
                "type": "string"
              },
              "start": {
                "type": "string"
              },
              "stop": {
                "type": "string"
              }
            },
            "anyOf": [
              {
                "required": [
                  "cidr"
                ]
              },
              {
                "required": [
                  "start",
                  "stop"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "cidrs"
      ]
    },
    "bgp": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "localASN": {
          "type": "integer"
        },
        "advertiseAllPools": {
          "type": "boolean"
        },
        "neighbors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "peerAddress": {
                "type": "string"
              },
              "peerASN": {
                "type": "integer"
              },
              "peerPort": {
                "type": "integer"
              },
              "myASN": {
                "type": "integer"
              },
              "nodeSelector": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "bfdProfile": {
                "type": "string"
              }
            },
            "required": [
              "peerAddress",
              "peerASN"
            ]
          }
        },
        "bfdProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "receiveInterval": {
                "type": "integer"
              },
              "transmitInterval": {
                "type": "integer"
              },
              "detectMultiplier": {
                "type": "integer"
              },
              "echoInterval": {
                "type": "integer"
              },
              "echoMode": {
                "type": "boolean"
              },
              "passiveMode": {
                "type": "boolean"
              },
              "minimumTtl": {
                "type": "integer"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      },
      "required": [
        "localASN",
        "neighbors"
      ]
    }
  },
  "required": [
    "l2",
    "ipPool",
    "bgp"
  ]
}
