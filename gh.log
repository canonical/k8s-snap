2026-10-01T03:15:04.5494439Z ##[endgroup]
2026-10-01T03:15:04.5580000Z ##[group]Display job file
2026-10-01T03:15:04.5604368Z job_queue: nvidia-igx-orin-dgpu-a6000
2026-10-01T03:15:04.5604862Z 
2026-10-01T03:15:04.5610003Z # IGX Orin devices are non-provision — no MAAS provisioning needed.
2026-10-01T03:15:04.5612046Z # The device runs whatever OS was last deployed onto it.
2026-10-01T03:15:04.5612665Z 
2026-10-01T03:15:04.5613712Z # The GPU operator takes up to 10-15 mins to compile/install drivers inside k8s.
2026-10-01T03:15:04.5614668Z global_timeout: 2700
2026-10-01T03:15:04.5614969Z 
2026-10-01T03:15:04.5615154Z test_data:
2026-10-01T03:15:04.5615596Z   attachments:
2026-10-01T03:15:04.5616075Z     - local: k8s-arm64.snap
2026-10-01T03:15:04.5616681Z     - local: k8s-test-suite.tar.gz
2026-10-01T03:15:04.5617288Z   test_cmds: |
2026-10-01T03:15:04.5617763Z     #!/bin/bash
2026-10-01T03:15:04.5618162Z     set -eux
2026-10-01T03:15:04.5618399Z 
2026-10-01T03:15:04.5618850Z     # IGX Orin noprovision devices ship with default ubuntu/ubuntu creds and no
2026-10-01T03:15:04.5619928Z     # pre-installed SSH keys, so we authenticate with sshpass.
2026-10-01T03:15:04.5621020Z     command -v sshpass >/dev/null 2>&1 || sudo apt-get install -y sshpass
2026-10-01T03:15:04.5623147Z     SSHPASS_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o PubkeyAuthentication=no -o PreferredAuthentications=password"
2026-10-01T03:15:04.5625261Z     SSH="sshpass -p ubuntu ssh $SSHPASS_OPTS ubuntu@$DEVICE_IP"
2026-10-01T03:15:04.5626155Z     SCP="sshpass -p ubuntu scp $SSHPASS_OPTS"
2026-10-01T03:15:04.5626623Z 
2026-10-01T03:15:04.5626853Z     # 1. Copy attachments to the device
2026-10-01T03:15:04.5627728Z     $SCP attachments/test/k8s-arm64.snap ubuntu@$DEVICE_IP:/tmp/
2026-10-01T03:15:04.5628771Z     $SCP attachments/test/k8s-test-suite.tar.gz ubuntu@$DEVICE_IP:/tmp/
2026-10-01T03:15:04.5629470Z 
2026-10-01T03:15:04.5629738Z     # 2. Set up test environment on the device
2026-10-01T03:15:04.5630846Z     # Use 'bash -s' to avoid login shell — .bash_logout can override
2026-10-01T03:15:04.5631829Z     # the exit code when clear_console fails over SSH with set -e.
2026-10-01T03:15:04.5632660Z     $SSH bash -s << 'REMOTE'
2026-10-01T03:15:04.5634760Z     set -eux
2026-10-01T03:15:04.5635579Z     export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
2026-10-01T03:15:04.5636367Z 
2026-10-01T03:15:04.5636854Z     # Install kernel headers (required for gpu-operator driver compilation)
2026-10-01T03:15:04.5637823Z     sudo apt-get update
2026-10-01T03:15:04.5638700Z     sudo apt-get install -y python3-pip python3-venv tox linux-headers-$(uname -r)
2026-10-01T03:15:04.5639469Z 
2026-10-01T03:15:04.5639752Z     # Verify kernel headers were installed
2026-10-01T03:15:04.5640438Z     echo "=== Kernel: $(uname -r) ==="
2026-10-01T03:15:04.5641174Z     ls /usr/src/linux-headers-$(uname -r)/ | head -5
2026-10-01T03:15:04.5641885Z     echo "=== GPU info ==="
2026-10-01T03:15:04.5642463Z     lspci | grep -i nvidia
2026-10-01T03:15:04.5643745Z     echo "=== Loaded nvidia modules ==="
2026-10-01T03:15:04.5644424Z     lsmod | grep nvidia || echo "none"
2026-10-01T03:15:04.5644859Z 
2026-10-01T03:15:04.5645062Z     # Unpack test suite
2026-10-01T03:15:04.5645584Z     cd /tmp
2026-10-01T03:15:04.5646067Z     tar xzf k8s-test-suite.tar.gz
2026-10-01T03:15:04.5646681Z     cd tests/integration
2026-10-01T03:15:04.5647024Z 
2026-10-01T03:15:04.5647458Z     # Run the GPU operator test directly on bare metal via SSH harness.
2026-10-01T03:15:04.5648391Z     export TEST_SNAP="/tmp/k8s-arm64.snap"
2026-10-01T03:15:04.5649066Z     export TEST_SUBSTRATE=bare_metal
2026-10-01T03:15:04.5649780Z     export TEST_BARE_METAL_SSH_HOST=localhost
2026-10-01T03:15:04.5650821Z     export TEST_BARE_METAL_SSH_USER=ubuntu
2026-10-01T03:15:04.5651506Z     export TEST_USE_LOCAL_MIRROR=0
2026-10-01T03:15:04.5652569Z     # IGX Orin has a system-wide containerd at the default path; relocate ours to avoid conflict.
2026-10-01T03:15:04.5654343Z     export TEST_CONTAINERD_BASE_DIR=/home/ubuntu
2026-10-01T03:15:04.5654860Z 
2026-10-01T03:15:04.5655279Z     # set +e: `set -e` would abort the script here on a non-zero tox exit,
2026-10-01T03:15:04.5656386Z     # skipping the diagnostics dump and the cleanup/unmount steps below.
2026-10-01T03:15:04.5657264Z     set +e
2026-10-01T03:15:04.5657771Z     tox -e integration -- \
2026-10-01T03:15:04.5658324Z         --tags gpu
2026-10-01T03:15:04.5658787Z     RC=$?
2026-10-01T03:15:04.5659222Z     set -e
2026-10-01T03:15:04.5659467Z 
2026-10-01T03:15:04.5659701Z     # Dump diagnostic info on failure
2026-10-01T03:15:04.5660371Z     if [ $RC -ne 0 ]; then
2026-10-01T03:15:04.5661087Z         echo "=== DIAGNOSTICS: gpu-operator namespace pods ==="
2026-10-01T03:15:04.5662140Z         sudo k8s kubectl get pods -n gpu-operator -o wide 2>/dev/null || true
2026-10-01T03:15:04.5663605Z         echo "=== DIAGNOSTICS: gpu-operator namespace daemonsets ==="
